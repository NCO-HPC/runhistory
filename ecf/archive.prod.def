suite prod
  family primary
  family cron
  family archive
  family archive
    family cfs
      edit PACKAGEHOME '/lfs/h1/ops/%ENVIR%/packages/cfs.%cfs_ver%'
      edit COM '/lfs/h1/ops/%ENVIR%/com'
      edit PROJ 'CFS'
      family v2.3
        family 00
          edit CYC '00'
          family misc
            task jcfs_cdas_archive
              cron 09:00
            task jcfs_archive
              cron 09:00
          endfamily
          family monthly
            task jcfs_cdas_monthly_archive
              cron 22:00
          endfamily
        endfamily
        family 06
          edit CYC '06'
          family misc
            task jcfs_archive
              cron 15:00
          endfamily
        endfamily
        family 12
          edit CYC '12'
          family misc
            task jcfs_archive
              cron 21:00
          endfamily
        endfamily
        family 18
          edit CYC '18'
          family misc
            task jcfs_archive
              cron 03:00
          endfamily
        endfamily
      endfamily
    endfamily
